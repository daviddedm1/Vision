<Window x:Class="Vision.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Command Center" Height="600" Width="1000"
        Background="#1E1E1E"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#252525" Padding="20">
            <TextBlock Text="Vision - Presentation Software" 
                       FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Groups Panel -->
        <Border Grid.Row="1" Grid.Column="0" Background="#2D2D2D" Padding="10">
            <StackPanel>
                <TextBlock Text="Groups" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="GroupList" 
                         Background="#3D3D3D" 
                         Foreground="White"
                         SelectionChanged="GroupList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Slides Panel -->
        <Border Grid.Row="1" Grid.Column="1" Background="#2D2D2D" Padding="10" Margin="10,0">
            <StackPanel>
                <TextBlock Text="Slides" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="SlideList" 
                         Background="#3D3D3D" 
                         Foreground="White"
                         SelectionChanged="SlideList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Preview Panel -->
        <Border Grid.Row="1" Grid.Column="2" Background="#2D2D2D" Padding="10">
            <StackPanel>
                <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#3D3D3D" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="PreviewContent" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Control Panel -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#252525" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Send" Click="Send_Click" 
                        Background="#0078D4" Foreground="White"
                        Padding="15,10" Margin="5" Width="80"/>
                <Button Content="New Playlist" Click="NewPlaylist_Click"
                        Background="#107C10" Foreground="White"
                        Padding="15,10" Margin="5" Width="100"/>
                <Button Content="Settings" Click="Settings_Click"
                        Background="#555555" Foreground="White"
                        Padding="15,10" Margin="5" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
